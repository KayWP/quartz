filters:
  and:
    - geo.contains(link("netherlands.base|Netherlands"))
properties:
  title:
    displayName: Resource
  category:
    displayName: Type
  period:
    displayName: Period
views:
  - type: table
    name: Resources
    order:
      - icon
      - title
      - category
      - period
    sort:
      - property: title
        direction: ASC
    cardSize: 260
